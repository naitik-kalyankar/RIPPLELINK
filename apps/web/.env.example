VITE_API_URL="http://localhost:4000"

# Supabase project settings (dashboard → Project Settings → API). Both are public/anon-scoped
# — safe to bundle into the web build and the Tauri desktop app, same trust level as
# VITE_API_URL above. Never put the service_role key here or anywhere in apps/web.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
