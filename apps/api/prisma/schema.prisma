generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CreatorDetectionStatus {
  detected
  mapped
  unknown
  failed
}

enum SubmissionAttemptStatus {
  ready
  uploading
  uploaded
  failed
  already_linked
}

enum ActivityLogLevel {
  info
  warning
  error
}

// Mirrors auth.users 1:1 (Supabase Auth) — id IS the Supabase user id, not a separate cuid.
// Populated automatically by a Postgres trigger on auth.users insert (see the RLS/auth
// migration SQL), so app code never has to create this row itself. is_admin is never
// settable by a user — only ever flipped by hand in the database by the app owner.
model Profile {
  id                 String    @id @db.Uuid
  email              String
  displayName        String?
  isAdmin            Boolean   @default(false)
  subscriptionTier   String?
  subscriptionStatus String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("profiles")
}

model InstagramAccount {
  id          String  @id @default(cuid())
  // Owning Supabase user — see Profile. Every query in routes/instagram.ts must be scoped by
  // this; RLS on the table enforces it independently as defense-in-depth (see auth migration).
  userId      String  @db.Uuid
  instagramId String  @unique
  username    String
  displayName String?
  active      Boolean @default(true)

  // Per-account Instagram Graph API credential — each Instagram Business account's access
  // token is scoped to whichever account it was generated for, so a single global token
  // (the original design) can't serve more than one account. Never serialized to the
  // frontend — see routes/instagram.ts. (No appId field: it's never used to make requests,
  // only the token is — /me and /media calls are authenticated by accessToken alone.)
  accessToken String?

  // CLIPPING's own internal ID for the social media account this Instagram account is
  // registered as on their side — required by their submit endpoint, and (like accessToken)
  // genuinely different per Instagram account, not a single global value. Not a secret
  // (unlike accessToken/the session cookie), so it's fine to include in API responses.
  clippingAccountId String?

  // Which CLIPPING login (Supabase account, identified by email) this Instagram account is
  // registered under on CLIPPING's side — CLIPPING accounts each have their own separate set
  // of linked Instagram accounts. Manually set for now (no reliable way yet to auto-discover
  // it — see clippingIdentity.ts for the "currently active in browser" half of this, which is
  // auto-detected). Not a secret.
  clippingOwnerEmail String?

  // Which ClippingAccount (a real row, Playwright-backed session) this Instagram account
  // belongs to. Additive alongside clippingOwnerEmail above rather than replacing it —
  // existing accounts keep working via the free-text email match/legacy singleton provider
  // until they're explicitly linked here. See ClippingAccountResolver.
  clippingAccountRefId String?
  clippingAccount      ClippingAccount? @relation(fields: [clippingAccountRefId], references: [id])

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reels Reel[]

  @@index([userId])
  @@map("instagram_accounts")
}

// A real CLIPPING.net login, held alive as a persistent Playwright browser context
// (see ClippingBrowserManager) instead of the single global env-var session used before
// multi-account support. storageStatePath holds the Playwright-persisted cookies/localStorage
// on disk (gitignored, same sensitivity as .env) — never serialized to the frontend.
model ClippingAccount {
  id               String    @id @default(cuid())
  userId           String    @db.Uuid
  label            String
  email            String?   @unique
  // Straight off CLIPPING's own sidebar avatar (see ClippingBrowserManager.scrapeIdentityFromPage)
  // — null when the account has no photo set there, in which case the app falls back to a
  // name-initial avatar, same as CLIPPING itself does.
  avatarUrl        String?
  apiUrl           String
  campaignId       String
  storageStatePath String
  active           Boolean   @default(true)
  lastUsedAt       DateTime?
  lastLoginAt      DateTime?

  // CLIPPING's own computed payout for this login, read straight off its campaign page's
  // clipperStats (see ClippingBrowserManager.getCampaignPageData) — refreshed every sync, not
  // derived from local Reel/ClippingSubmission data. This is what actually matches
  // clipping.net's own numbers; the dashboard's separate "Live" estimate is a local
  // approximation using this app's own Instagram sync, not this value.
  lastPayout                Float?
  // Array of { bounty, views, rate, payout, minViewsRequired, minViewsReached } — CLIPPING's
  // own per-bounty breakdown for this login, same source as lastPayout above.
  lastPayoutBountyBreakdown Json?
  lastPayoutFetchedAt       DateTime?

  // The full admin-payouts snapshot for this account (paidTotal, pendingTotal, paymentMethod,
  // history — see routes/admin.ts's serializeAdminSnapshot) — kept around so a dead/unreachable
  // session shows the last successfully known data instead of blanking to zero. Overwritten
  // only when a fresh live fetch actually succeeds; never cleared by a failed one.
  lastAdminPayoutSnapshot   Json?
  lastAdminPayoutSnapshotAt DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  instagramAccounts InstagramAccount[]
  payoutSplits      PayoutSplit[]

  @@index([userId])
  @@map("clipping_accounts")
}

// How one ClippingAccount's real payout (from CLIPPING's own /api/clipper/earnings) is split
// between named people — e.g. Riyaan's login might be 50% "Mine" / 50% "Alex", while Snipey's
// is split differently. Purely a local bookkeeping label; CLIPPING itself has no concept of
// this, it's never sent anywhere.
model PayoutSplit {
  id                String   @id @default(cuid())
  userId            String   @db.Uuid
  clippingAccountId String
  name              String
  percentage        Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clippingAccount ClippingAccount @relation(fields: [clippingAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clippingAccountId])
  @@map("payout_splits")
}

// Per-user creator catalog — detection results for the same real-world creator don't carry
// across users (each user's Reels/OCR detections build up their own).
model Creator {
  id                 String   @id @default(cuid())
  userId             String   @db.Uuid
  detectedIdentifier String
  displayName        String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  aliases CreatorAlias[]
  reels   Reel[]

  @@unique([userId, detectedIdentifier])
  @@index([userId])
  @@map("creators")
}

model CreatorAlias {
  id                 String   @id @default(cuid())
  userId             String   @db.Uuid
  creatorId          String
  detectedIdentifier String
  createdAt          DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, detectedIdentifier])
  @@index([userId])
  @@map("creator_aliases")
}

model Reel {
  id                     String                  @id @default(cuid())
  // Denormalized from instagramAccount.userId at write time — Reel is the hottest-read table,
  // so RLS/list queries check this flat column instead of joining through InstagramAccount.
  userId                 String                  @db.Uuid
  instagramAccountId     String
  instagramReelId        String
  instagramUrl           String
  thumbnailUrl           String
  publishedAt            DateTime?
  views                  Int?
  creatorId              String?
  detectedIdentifier     String?
  creatorDetectionStatus CreatorDetectionStatus  @default(unknown)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  instagramAccount   InstagramAccount    @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  creator            Creator?            @relation(fields: [creatorId], references: [id])
  clippingSubmission ClippingSubmission?
  submissionAttempts SubmissionAttempt[]

  @@unique([instagramAccountId, instagramReelId])
  @@index([userId])
  @@index([creatorDetectionStatus])
  @@index([publishedAt])
  @@map("reels")
}

// Real bounty tags/rates/active-state, learned by scraping CLIPPING's own campaign page —
// per-user since each user's CLIPPING login is a separate scrape (rates could differ per
// account/campaign even when the tag name matches another user's).
model ClippingBounty {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  name       String
  active     Boolean  @default(true)
  rate       String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("clipping_bounties")
}

model ClippingSubmission {
  id              String    @id @default(cuid())
  // Denormalized from reel.userId at write time (see SubmissionService) — same flat-column
  // reasoning as Reel.userId above.
  userId          String    @db.Uuid
  reelId          String?   @unique
  clippingClipId  String    @unique
  videoId         String
  campaignId      String?
  bountyTag       String?
  clippingUrl     String?
  status          String    @default("submitted")
  isBeingTracked  Boolean   @default(true)
  views           Int?
  likes           Int?
  comments        Int?
  dateAdded       DateTime?
  dateCreated     DateTime?
  lastUpdated     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reel Reel? @relation(fields: [reelId], references: [id])

  @@index([userId])
  @@index([videoId])
  @@map("clipping_submissions")
}

model SubmissionAttempt {
  id           String                   @id @default(cuid())
  userId       String                   @db.Uuid
  reelId       String
  status       SubmissionAttemptStatus
  errorMessage String?
  attemptedAt  DateTime                 @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reelId])
  @@map("submission_attempts")
}

model ActivityLog {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  message   String
  level     ActivityLogLevel @default(info)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}
