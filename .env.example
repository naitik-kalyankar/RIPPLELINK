# --- Database ---
# Points at your Supabase project's Postgres connection string (dashboard → Project Settings →
# Database → Connection string) once multi-user auth is set up — NOT the anon key, this is a
# real Postgres credential and server-only, never sent to the frontend/Tauri. Local Postgres
# (below) only makes sense for a single-user/pre-auth checkout of this app.
DATABASE_URL="postgresql://kickmanager:kickmanager@localhost:5432/kickmanager?schema=public"

# --- Auth (server-only) ---
# Same project URL as VITE_SUPABASE_URL below — used to verify Supabase sessions via its
# public JWKS endpoint (no secret needed for this, and it isn't sent to the frontend from
# here regardless).
SUPABASE_URL=

# --- API server ---
PORT=4000
NODE_ENV=development
# Comma-separated — needs BOTH the web dev/prod origin AND the Tauri webview's origin (a
# different scheme entirely, e.g. tauri://localhost on macOS/Linux or https://tauri.localhost
# on Windows) if you're running the desktop build against this API.
CORS_ORIGIN="http://localhost:5173,tauri://localhost"

# --- Instagram ---
# Credentials live per-account now, not here — each Instagram account you add in the app
# (Instagram Accounts page) has its own access token field. Leave an account's token blank to
# use the mock provider for just that account; set it to fetch real Reels for that account.
# See tools/clipping-cookie-sync-extension's README-adjacent docs / Settings page for how to
# generate a token via Graph API Explorer.

# --- CLIPPING (leave blank to use MockClippingProvider) ---
# CLIPPING has no official API. Real mode replays a logged-in browser session instead of an
# API key — there is no other working auth. All three vars below must be set to enable it.
#
# CLIPPING_API_URL: the site's origin, e.g. https://clipping.net
#
# CLIPPING_SESSION_COOKIE: the ENTIRE raw `Cookie:` request header value from a logged-in
# browser session — open devtools, make any request to clipping.net, copy the whole Cookie
# header (it will look like `sb-<project>-auth-token.0=...; sb-<project>-auth-token.1=...`).
# This is a live credential for your account: never commit it, never share it, and expect to
# replace it roughly every hour — it's a short-lived Supabase session token with no
# auto-refresh here by design. Requests fail with a clear "session expired" error when it's
# stale; just paste a fresh one from devtools and restart the API.
#
# CLIPPING_CAMPAIGN_ID: the campaign's Mongo ID, visible in the URL of your CLIPPING
# dashboard's clips list (e.g. .../campaigns/<this-id>/clips) or in that request's URL.
#
# There is no CLIPPING_ACCOUNT_ID here — that ID is per-Instagram-account (each account maps
# to a different one on CLIPPING's side), so it lives on each account's row in the app
# (Instagram Accounts page → Credentials), same as the Instagram access token.
CLIPPING_API_URL=
CLIPPING_SESSION_COOKIE=
CLIPPING_CAMPAIGN_ID=

# --- Web app (also apps/web/.env — see apps/web/.env.example) ---
VITE_API_URL="http://localhost:4000"
# Both public/anon-scoped — safe in the web build and the Tauri bundle. Never the service_role
# key, and never put a privileged key in a VITE_-prefixed var (Vite bundles those into the
# client).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
